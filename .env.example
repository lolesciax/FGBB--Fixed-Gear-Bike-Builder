NODE_ENV=development
PORT=4000
FRONTEND_URL=http://127.0.0.1:5180
MONGODB_URI=mongodb://127.0.0.1:27017/tracklab?replicaSet=rs0
# Optional explicit database selection, useful for a dedicated Atlas development DB.
MONGODB_DB_NAME=tracklab_dev
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=replace-with-at-least-48-random-characters-before-deploying
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
DEVELOPMENT_EPHEMERAL=false
# Optional for local development without Redis. Business quotas still use MongoDB.
DEVELOPMENT_MEMORY_RATE_LIMITS=false
GUEST_CHANGES=12
GUEST_PREVIEWS=1
BUILD_LIMIT=5
CREATE_DAILY_LIMIT=3
CREATE_MONTHLY_LIMIT=20
PUBLISH_LIMIT=3
EXPORT_DAILY_LIMIT=5
CATALOG_GUEST_RPM=60
CATALOG_USER_RPM=120
GENERAL_RPM=120
SAVE_HOURLY_LIMIT=30
PRICING_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TrackLab <noreply@example.com>
ASSET_CDN_URL=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
LOG_LEVEL=info
# Frontend: empty means same-origin /api, proxied by Vite in development.
VITE_API_URL=
