{
  "name": "tracklab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/domain"
  ],
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "dev:test": "tsx scripts/e2e-server.ts",
    "preview:test": "tsx scripts/e2e-server.ts --preview",
    "build": "npm run typecheck && npm run build:web && npm run build:api",
    "build:web": "vite build --config frontend/vite.config.ts",
    "build:api": "tsup backend/src/server.ts --format esm --platform node --target node22 --out-dir backend/dist --no-splitting --external mongodb-memory-server",
    "start": "node backend/dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "npm run build:web && playwright test --config playwright.pwa.config.ts",
    "seed": "tsx backend/src/seed.ts",
    "db:check": "tsx backend/src/check-database.ts",
    "db:verify-persistence": "tsx scripts/verify-database-persistence.ts",
    "setup:development": "node scripts/setup-development.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "assets:generate": "node scripts/generate-models.mjs",
    "validate:deployment": "node scripts/validate-deployment.mjs",
    "assets:frames": "tsx scripts/export-frame-kits.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^6.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.105.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.62.0",
    "mongoose": "^9.11.4",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "redis": "^6.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^2.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
